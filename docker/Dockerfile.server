# bookworm-slim rather than alpine: better-sqlite3 publishes prebuilt glibc binaries, so
# the image needs no python3/make/g++ and skips compiling SQLite from source against musl.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src
COPY db ./db

# The queue file lives on a mounted volume; make sure the unprivileged user owns the mount point.
RUN mkdir -p /app/data && chown -R node:node /app
USER node

# 3000 is the webhook listener, reached only by cloudflared over agent-net and never published to
# the host. 3001 is the control listener, published to 127.0.0.1 only.
EXPOSE 3000 3001

# /api/health lives on the control listener, so probe that port. Fetching 127.0.0.1 sets a Host
# header the control guard's allowlist accepts, and no Origin or Sec-Fetch-* headers are sent.
# No curl in the slim image, so probe with node itself.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.CONTROL_PORT||3001)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/server.mjs"]
