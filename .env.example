# Copy to .env and fill in. Never commit the filled-in file.
# Generate secrets with: openssl rand -hex 32

# --- Server ---
# Webhook listener. Reached only by cloudflared over agent-net; never published to the host.
PORT=3000
# Control listener: poll, tasks, complete, fail, heartbeat, health. Published to 127.0.0.1 only.
CONTROL_PORT=3001
DB_PATH=/app/data/agent_queue.db
PROJECTS_CONFIG=/config/projects.json

# Host port the control listener is published on. Give each isolated stack a distinct value.
CONTROL_HOST_PORT=3001

# Host header allowlist for the control listener. A CLI sends a matching Host and no Origin or
# Sec-Fetch-* headers; a browser cannot satisfy all three, which is what stops DNS rebinding.
# CONTROL_ALLOWED_HOSTS=127.0.0.1:3001,localhost:3001

# Also require the peer address to be loopback. Leave false under Docker, where port publishing
# rewrites the peer to the bridge gateway and every legitimate request looks non-local.
CONTROL_REQUIRE_LOOPBACK_PEER=false

# Verify webhook source IPs against the hooks ranges from api.github.com/meta, behind the HMAC.
# "warn" logs mismatches instead of rejecting them.
WEBHOOK_IP_CHECK=enforce

# Isolated mode only. Leave unset for the shared multi-tenant instance.
# When set, this instance serves ONLY that project and rejects every other repo.
# PROJECT_SLUG=main-app

# --- Secrets ---
# Fallback webhook secret, used by any project without its own webhook_secret_env.
GITHUB_WEBHOOK_SECRET=
# Per-project override. The name must match "webhook_secret_env" in projects.json.
# WEBHOOK_SECRET_MAIN_APP=
# Bearer token the orchestrator presents to /api/agent/poll and the task endpoints.
AGENT_POLL_SECRET=

# --- Queue behaviour ---
# Reject webhooks from repos absent from projects.json. Keep false in multi-tenant mode.
ALLOW_UNKNOWN_REPOS=false
# How long a claimed task stays leased before the reaper returns it to pending.
LEASE_SECONDS=1800
REAPER_INTERVAL_SECONDS=30
MAX_ATTEMPTS=3
# First retry delay after a failure; doubles each attempt.
RETRY_BACKOFF_SECONDS=60

# --- Cloudflare quick tunnel ---
# cloudflared's metrics endpoint, used at boot to log the public webhook URL.
# Set to an empty string to skip the lookup. Never publish this port to the host.
TUNNEL_METRICS_URL=http://cloudflare-tunnel:2000


# ============================================================================
# Host orchestrator — put these in .env.orchestrator, NOT in this file.
# ============================================================================
# Deliberately a separate file: the queue container's env_file should hold only the webhook and
# poll secrets. Every credential worth isolating lives on the host and reaches a runner one task
# at a time through a 0600 file, never as an environment variable.
#
#   cp the block below into .env.orchestrator, then: node orchestrator/index.mjs
#
# --- Queue control plane ---
# QUEUE_CONTROL_HOST=127.0.0.1
# QUEUE_CONTROL_PORT=3001
# A unix socket bound inside the queue container is NOT connectable from the macOS host (the
# socket inode appears over VirtioFS but connect() gives ECONNREFUSED), so this stays unset
# unless you run the queue directly on the host.
# QUEUE_CONTROL_SOCKET=
# QUEUE_TIMEOUT_MS=15000
#
# --- Secrets ---
# Must match the queue's AGENT_POLL_SECRET.
# AGENT_POLL_SECRET=
# The agent's own token, never a human's — the trigger guard in src/triggers.mjs identifies the
# agent's comments by author, so sharing a login makes the agent answer itself in a loop.
# Fine-grained PATs only reach repos their resource owner *owns*, so a machine user that is merely
# a collaborator cannot use one: give that account a classic token with the single `repo` scope.
# Blast radius is then bounded by which repos the account has been invited to, so invite it to few.
# GITHUB_TOKEN=
# CURSOR_API_KEY=
# Only needed for projects with a "neon" block. NEVER reaches a container: it is org-scoped and
# can delete entire projects, and the runner only needs the DATABASE_URL that came out of it.
# NEON_API_KEY=
#
# Read the three long-lived secrets from the macOS Keychain instead of this file. Keychain ACLs
# prompt per binary, which beats a plaintext file any process running as you can read — neither
# ~/Developer nor ~/.tmt-agent is TCC-protected. Store them with:
#   security add-generic-password -s tmt-agent -a GITHUB_TOKEN -w
# SECRETS_FROM_KEYCHAIN=false
# KEYCHAIN_SERVICE=tmt-agent
#
# --- Poll loop ---
# POLL_INTERVAL_MS=10000
# POLL_JITTER_MS=2000
# MAX_CONCURRENT_TASKS=2
# WORKER_NAME=orchestrator
#
# --- Task execution ---
# TASK_TIMEOUT_MS=2700000
# HEARTBEAT_INTERVAL_SECONDS=60
# always | on-failure | never
# KEEP_ARTIFACTS=on-failure
# AGENT_WORKDIR=~/.tmt-agent
# Use the agent account's GitHub noreply address so commits attribute to it rather than to nobody.
# GIT_AUTHOR_NAME=tmt-agent
# GIT_AUTHOR_EMAIL=<id>+tmt-agent@users.noreply.github.com
#
# --- Preview deployment comments ---
# After a successful execute task, comment the deployment URL Vercel (or any integration reporting
# to GitHub's Deployments API) published for the pushed commit. Needs no extra credential.
# PREVIEW_COMMENTS=true
# How long to wait for a deployment to appear before deciding the repo has no hosting attached.
# PREVIEW_GRACE_MS=45000
# How long to wait for the build to finish. A still-building preview is commented anyway.
# PREVIEW_TIMEOUT_MS=180000
# PREVIEW_POLL_INTERVAL_MS=5000
#
# --- Runner container ---
# RUNNER_IMAGE=tmt-agent-runner
# RUNNER_NETWORK=tmt-agent-runners
# RUNNER_MEMORY=4g
# RUNNER_CPUS=2
# RUNNER_PIDS_LIMIT=512
# Mount /tmp noexec. Off by default because an npm postinstall may need to exec from there.
# RUNNER_NOEXEC_TMP=false
# On macOS, node_modules defaults to a per-container tmpfs (uid 1001) instead of a named volume.
# Set RUNNER_MODULES_TMPFS=false to use tmt-agent-modules-<slug> (Linux default); if npm ci hits
# EACCES, remove the poisoned volume: docker volume rm tmt-agent-modules-<slug>
# RUNNER_MODULES_TMPFS=true
#
# --- Herdr ---
# Fail a task when Herdr is unreachable instead of running the container detached.
# HERDR_REQUIRED=false
# HERDR_BIN=herdr
